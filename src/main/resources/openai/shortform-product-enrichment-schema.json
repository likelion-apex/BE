{
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestKey", "displayBrand", "displayProductName", "marketOrVariant", "lookupStatus", "resolutionConfidence", "notes", "sources", "ingredients"],
        "properties": {
          "requestKey": {"type": "string", "minLength": 1, "maxLength": 64},
          "displayBrand": {"type": ["string", "null"], "maxLength": 100},
          "displayProductName": {"type": ["string", "null"], "maxLength": 160},
          "marketOrVariant": {"type": ["string", "null"], "description": "국가·판매처 문구를 제외한 단일 제품 용량. 예: 100ml, 50g", "maxLength": 120},
          "lookupStatus": {"type": "string", "enum": ["FOUND", "ESTIMATED", "AMBIGUOUS", "NOT_FOUND"]},
          "resolutionConfidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": ["string", "null"], "maxLength": 500},
          "sources": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "title", "sourceType"],
              "properties": {
                "url": {"type": "string", "minLength": 8, "maxLength": 2048},
                "title": {"type": ["string", "null"], "maxLength": 300},
                "sourceType": {"type": "string", "enum": ["OFFICIAL", "RETAILER", "DATABASE", "OTHER"]}
              }
            }
          },
          "ingredients": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["order", "name", "purposes", "skinBenefits", "riskScore", "caution20", "allergen"],
              "properties": {
                "order": {"type": "integer", "minimum": 1, "maximum": 200},
                "name": {"type": "string", "minLength": 1, "maxLength": 100},
                "purposes": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 80}},
                "skinBenefits": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 80}},
                "riskScore": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
                "caution20": {"type": "boolean"},
                "allergen": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}

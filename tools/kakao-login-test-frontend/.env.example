# 배포된 백엔드 주소입니다. 끝의 슬래시는 생략하세요.
VITE_BACKEND_URL=https://mutsa.dev.me.kr

# 카카오 REST API 키(Client ID)만 입력합니다. Client Secret은 절대 넣지 마세요.
VITE_KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key

# 카카오 콘솔과 백엔드 KAKAO_REDIRECT_URI에도 같은 값을 등록해야 합니다.
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/onboarding/kakaocallback

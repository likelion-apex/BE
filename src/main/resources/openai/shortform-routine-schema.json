{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "tag", "highlights", "coreGoal", "synergyCombo", "summary", "warnings", "steps", "inventoryRecommendations"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 40},
    "tag": {"type": "string", "minLength": 1, "maxLength": 30},
    "highlights": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "maxLength": 80}},
    "coreGoal": {"type": "string", "minLength": 1, "maxLength": 80},
    "synergyCombo": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "warnings": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 160}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "scoreBreakdown", "keyBenefits", "reasons"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "scoreBreakdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skinTypeFit", "benefitFit"],
            "properties": {
              "skinTypeFit": {"type": "integer", "minimum": 0, "maximum": 40},
              "benefitFit": {"type": "integer", "minimum": 0, "maximum": 35}
            }
          },
          "keyBenefits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 1, "maxLength": 18}
          },
          "reasons": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assessmentCategory", "title", "description", "evidenceSource"],
              "properties": {
                "assessmentCategory": {"type": "string", "enum": ["SAFE", "BENEFICIAL", "CAUTION", "WARNING"]},
                "title": {"type": "string", "minLength": 1, "maxLength": 80},
                "description": {"type": "string", "minLength": 1, "maxLength": 240},
                "evidenceSource": {"type": "string", "minLength": 1, "maxLength": 80}
              }
            }
          }
        }
      }
    },
    "inventoryRecommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "inventoryId", "reason"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "inventoryId": {"type": ["integer", "null"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    }
  }
}
